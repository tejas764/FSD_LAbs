# ─────────────────────────────────────────────────────────────────────────────
# CrisisMap API — production environment variables template
# Copy to apps/api/.env (or inject via AWS Secrets Manager / App Runner env)
# NEVER commit real values — this file contains placeholders only.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
API_PORT=4000

# ── Database (RDS PostgreSQL 15 + PostGIS) ────────────────────────────────────
DATABASE_URL=postgresql://<user>:<password>@<rds-host>:5432/crisismap?sslmode=require

# ── Cache / Queues (ElastiCache Serverless) ───────────────────────────────────
REDIS_URL=redis://<elasticache-host>:6379
REDIS_HOST=<elasticache-host>
REDIS_PORT=6379
# REDIS_DB=0  # Default 0 for dev/prod; tests use DB 1 to avoid sharing queues with running server
# REDIS_PASSWORD=<elasticache-auth-token>

# ── Object Storage (AWS S3) ───────────────────────────────────────────────────
STORAGE_ENDPOINT=https://s3.amazonaws.com
STORAGE_REGION=us-east-1
STORAGE_BUCKET=crisismap-reports-prod
STORAGE_ACCESS_KEY_ID=<iam-access-key-or-instance-role>
STORAGE_SECRET_ACCESS_KEY=<iam-secret-key-or-instance-role>
STORAGE_PUBLIC_URL=https://crisismap-reports-prod.s3.amazonaws.com

# ── Auth ──────────────────────────────────────────────────────────────────────
# Must match NEXTAUTH_SECRET used in apps/web production deployment
BETTER_AUTH_SECRET=<openssl rand -base64 32>
# Trusted origin for better-auth CORS — must match the deployed frontend URL
BETTER_AUTH_URL=https://crisismap.vercel.app
# BETTER_AUTH_JWT_ISSUER=crisismap
# BETTER_AUTH_JWT_AUDIENCE=crisismap-admin

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://crisismap.vercel.app,https://crisismap.example.com

# ── Trust proxy (set to 1 when running behind App Runner / ALB) ───────────────
TRUST_PROXY=1
API_PUBLIC_URL=https://api.crisismap.example.com

# ── AI Classification (Anthropic) ─────────────────────────────────────────────
AI_CLASSIFICATION_ADAPTER=runtime
ANTHROPIC_API_KEY=<sk-ant-...>
# ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_API_BASE_URL=https://api.anthropic.com

# ── Translation ───────────────────────────────────────────────────────────────
# Use 'libretranslate' for self-hosted or replace with hosted API
TRANSLATION_ADAPTER=libretranslate
LIBRETRANSLATE_URL=https://<libretranslate-host>

# ── Email (AWS SES) ───────────────────────────────────────────────────────────
SMTP_HOST=email-smtp.<region>.amazonaws.com
SMTP_PORT=587
SMTP_FROM=noreply@crisismap.example.com

# ── Abuse Controls ────────────────────────────────────────────────────────────
RATE_LIMIT_PER_HOUR=10
RATE_LIMIT_ADMIN_EXPORT_PER_MINUTE=30
RATE_LIMIT_ADMIN_CRISIS_WRITE_PER_MINUTE=30

# ── One-time seed endpoint (POST /api/v1/setup/seed) ─────────────────────────
# Generate with: openssl rand -hex 32
# Remove or leave unset to disable the endpoint entirely.
SEED_SECRET=<openssl rand -hex 32>

# ── Data Retention ────────────────────────────────────────────────────────────
# Days before reports are soft-deleted / anonymised (default: 730)
RETENTION_DAYS=730
