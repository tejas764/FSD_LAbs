# API local environment
# Copy to apps/api/.env for local API development

NODE_ENV=development

# Database
DATABASE_URL=postgresql://crisismap:crisismap@localhost:5432/crisismap

# API runtime
API_PORT=4000

# Security
CORS_ORIGINS=http://localhost:3000
# TRUST_PROXY=1
# API_PUBLIC_URL=https://api.crisismap.example

# Redis (used by cache + BullMQ)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_DB=0  # Default 0 for dev/prod; tests use DB 1 to avoid sharing queues with running server
# REDIS_PASSWORD=

# Object storage (MinIO locally)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=crisismap-reports
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_PUBLIC_URL=http://localhost:9000/crisismap-reports

# Queue adapter selection
# mock | runtime
AI_CLASSIFICATION_ADAPTER=mock
# ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_API_BASE_URL=https://api.anthropic.com
# mock | libretranslate
TRANSLATION_ADAPTER=mock

# Translation provider
LIBRETRANSLATE_URL=http://localhost:5000

# Anthropic provider
# ANTHROPIC_API_KEY=

# better-auth secret (shared with apps/web BETTER_AUTH_SECRET)
BETTER_AUTH_SECRET=change-me
# Trusted origin for better-auth CORS — set to the frontend URL in Codespaces/prod
# BETTER_AUTH_URL=http://localhost:3000
# BETTER_AUTH_JWT_ISSUER=crisismap
# BETTER_AUTH_JWT_AUDIENCE=crisismap-admin

# Abuse controls
RATE_LIMIT_PER_HOUR=10
RATE_LIMIT_ADMIN_EXPORT_PER_MINUTE=30
RATE_LIMIT_ADMIN_CRISIS_WRITE_PER_MINUTE=30

# Retention worker
# Number of days before reports are soft-deleted/anonymized (default: 730)
RETENTION_DAYS=730
