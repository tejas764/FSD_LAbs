# Web local environment
# Copy to apps/web/.env.local for local frontend development

# Public API URL for browser requests
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Internal API URL for server-side requests (SSR/actions)
API_INTERNAL_BASE_URL=http://localhost:4000

# better-auth settings (must align with apps/api)
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3000

# Optional runtime tuning
# MAX_PHOTO_SIZE_MB=5
# NEXT_PUBLIC_OFFLINE_MAX_ATTEMPTS=5
